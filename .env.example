# Local-only overrides. No AWS credentials or real passwords belong in Git.
# Copy to .env (which is git-ignored) and edit. Defaults work without this file.
WEB_PORT=5183
API_PORT=8183

# --- Live AI mode (optional, off by default) ---------------------------------------------
# Live inference makes billable Bedrock calls. It stays off until you set all three of these.
# KDAA_LLM_ENABLED=1
# BEDROCK_REGION=us-east-1
# Use a model or inference-profile ID that your account actually has access to in that region:
#   aws bedrock list-inference-profiles --region "$BEDROCK_REGION"
# BEDROCK_MODEL_ID=

# Credentials use the standard AWS chain and are never read by application code.
# Either set a profile and mount ~/.aws with compose.llm.yml:
# AWS_PROFILE=default
# AWS_REGION=us-east-1
# The credential provider needs its own region: BEDROCK_REGION reaches the Bedrock client only.
# A profile with no `region` key fails with NoRegionError, which the adapter can only report as an
# unrecognised model. Set AWS_REGION here, or add `region` to the profile.
#
# A profile created by `aws login` (a `login_session` key) cannot use that overlay: it refreshes by
# writing to ~/.aws/login/cache, and the mount is read-only. Export short-lived credentials from it
# instead, leave AWS_PROFILE unset, and use the ordinary `docker compose up -d --build`:
#   eval "$(aws configure export-credentials --profile <name> --region <region> --format env)"
#
# ...or supply short-lived environment credentials here. Never commit real values.
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=

# Bounds. Nothing is truncated silently: exceeding an input bound fails the run.
# LLM_MAX_INPUT_CHARS=120000
# LLM_MAX_OUTPUT_TOKENS=4000
# LLM_MAX_CANDIDATES=8
# LLM_MAX_MODEL_CALLS=12
# LLM_TIMEOUT_SECONDS=60
# LLM_TOTAL_ATTEMPTS=3
